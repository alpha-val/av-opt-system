{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: Debug (venv_3.12)",
      "type": "python",
      "request": "launch",
      "module": "flask",
      "jinja": true,
      "env": {
        "FLASK_APP": "app:create_app()",
        "FLASK_ENV": "development"
      },
      "args": ["run", "--no-debugger"],
      "cwd": "${workspaceFolder}/backend",
      "pythonPath": "${workspaceFolder}/backend/venv_3.12/bin/python3",
      "justMyCode": true
    },

    // --- FastAPI / Uvicorn (with reload AND breakpoints) ---
    {
      "name": "FastAPI: Debug (venv_3.12)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.app_fastapi:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "app",
        "--log-config",
        "logging_config.json"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "pythonPath": "${workspaceFolder}/backend/venv_3.12/bin/python3",
      "justMyCode": true,
      "subProcess": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },

    // --- FastAPI / Uvicorn (dev mode - faster reload, no breakpoints) ---
    {
      "name": "FastAPI: Dev (Reload)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.app_fastapi:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "app"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "pythonPath": "${workspaceFolder}/backend/venv_3.12/bin/python3",
      "justMyCode": true,
      "subProcess": true,
      "console": "integratedTerminal"
    }
  ]
}
