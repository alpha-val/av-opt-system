{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: Debug (venv_3.12)",
      "type": "python",
      "request": "launch",
      "module": "flask",
      "jinja": true,
      "env": {
        "FLASK_APP": "app:create_app()", // factory pattern
        "FLASK_ENV": "development"
      },
      "args": [
        "run",
        "--no-debugger" // VS Code debugger will handle breakpoints
        // "--no-reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "pythonPath": "${workspaceFolder}/backend/venv_3.12/bin/python3",
      "justMyCode": true
    },

    // --- FastAPI / Uvicorn (no reload) — best for breakpoint debugging ---
    {
      "name": "FastAPI: Debug (venv_3.12)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.app_fastapi:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "pythonPath": "${workspaceFolder}/backend/venv_3.12/bin/python3",
      "justMyCode": true,
      "console": "integratedTerminal"
    },

    // --- FastAPI / Uvicorn (with --reload) — convenient dev mode ---
    {
      "name": "FastAPI: Dev (Reload)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.app_fastapi:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "app"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "pythonPath": "${workspaceFolder}/backend/venv_3.12/bin/python3",
      "justMyCode": true,
      "subProcess": true, // uvicorn --reload spawns a subprocess
      "console": "integratedTerminal"
    }
  ]
}
