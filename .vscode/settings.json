{
  // Force VS Code + debugpy to use your venv interpreter
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/venv_3.12/bin/python",

  // Activate the venv in terminals VS Code creates
  "python.terminal.activateEnvironment": true,

  // Help analysis resolve site-packages inside your venv
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "postman.settings.dotenv-detection-notification-visibility": false,
  "github.copilot.chat.summarizeAgentConversationHistory.enabled": false,
  "workbench.preferredDarkColorTheme": "Default Light+",

  "python.envFile": "${workspaceFolder}/backend/.env",
  "python.analysis.diagnosticMode": "workspace",
  "python.languageServer": "None",
  "python.analysis.extraPaths": ["./"],
  "python.analysis.indexing": true,
  "cursorpyright.analysis.diagnosticMode": "workspace",
  "cursorpyright.analysis.extraPaths": [
    "./"
  ]
}
