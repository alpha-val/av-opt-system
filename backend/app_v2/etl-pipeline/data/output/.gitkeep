import fitz  # PyMuPDF
import pandas as pd
from app_v2.core.database import get_database
from app_v2.repositories.project_repo import ProjectRepository
from app_v2.repositories.option_repo import OptionRepository
from app_v2.repositories.table_repo import TableRepository
from app_v2.schemas.project import ProjectCreate
from app_v2.schemas.option import OptionCreate
from app_v2.schemas.table import TableCreate

async def extract_text_from_pdf(pdf_path):
    """Extract text from a PDF file."""
    text = ""
    with fitz.open(pdf_path) as doc:
        for page in doc:
            text += page.get_text()
    return text

async def extract_table_from_pdf(pdf_path):
    """Extract tables from a PDF file."""
    tables = pd.read_pdf(pdf_path, pages='all')
    return tables

async def transform_project_data(raw_text):
    """Transform raw text into structured project data."""
    # Example transformation logic
    project_data = {
        "name": "Extracted Project Name",
        "description": "Extracted Project Description",
        "metadata": {
            "country": "Chile",
            "region": "Antofagasta",
            # Add more metadata extraction logic here
        },
        # Add other fields as necessary
    }
    return project_data

async def load_project_data(db, project_data):
    """Load project data into the database."""
    project_repo = ProjectRepository(db)
    project_create = ProjectCreate(**project_data)
    await project_repo.create(project_create)

async def load_table_data(db, table_data):
    """Load table data into the database."""
    table_repo = TableRepository(db)
    for index, row in table_data.iterrows():
        table_create = TableCreate(**row.to_dict())
        await table_repo.create(table_create)

async def etl_pipeline(pdf_path):
    """ETL pipeline for ingesting data from PDF files."""
    db = await get_database()

    # Extract data
    raw_text = await extract_text_from_pdf(pdf_path)
    table_data = await extract_table_from_pdf(pdf_path)

    # Transform data
    project_data = await transform_project_data(raw_text)

    # Load data
    await load_project_data(db, project_data)
    await load_table_data(db, table_data)

# Example usage
# asyncio.run(etl_pipeline("path/to/your/project_report.pdf"))